{
  "expo": {
    "name": "Bookshelf",
    "slug": "bookshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookshelf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bookshelf.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Bookshelf usa la cámara para fotografiar la portada o el lomo de un libro y proponerte sus datos.",
        "NSPhotoLibraryUsageDescription": "Bookshelf usa tus fotos solo cuando eliges una imagen como portada de un libro."
      }
    },
    "android": {
      "package": "com.bookshelf.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F4EBDC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EBDC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Bookshelf usa la cámara para fotografiar la portada o el lomo de un libro y proponerte sus datos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookshelf usa tus fotos solo cuando eliges una imagen como portada de un libro.",
          "cameraPermission": "Bookshelf usa la cámara para fotografiar la portada o el lomo de un libro y proponerte sus datos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9904a7f0-78d1-4396-8ee0-698eb08b0d65"
      }
    },
    "owner": "juls2212s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9904a7f0-78d1-4396-8ee0-698eb08b0d65"
    }
  }
}
